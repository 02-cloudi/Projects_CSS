<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="styles.css">
    <title>Business Card</title>
</head>

<body>
    <div class="business-card">
        <img class="profile-image" src="https://cdn.freecodecamp.org/curriculum/labs/flower.jpg" alt="pinkflower">
        <p class="full-name">XYZ</p>
        <p class="designation">Web Developer</p>
        <p class="company">Telsa</p>

        <hr>

        <p>Email: xyz@telsa.com</p>
        <p>Phone: +65-9001-0001</p>

        <a class="portfolio-link" href="http://example.com/$0">Portfolio</a>

        <hr>

        <div class="social-media">
        <h2>Connect with me</h2>
        <a href="http://twitter.com/$0">Twitter</a>
        <a href="http://linkedin.com/$0">LinkedIn</a>
        <a href="http://github.com/$0">GitHub</a>
        </div>

    </div>

</body>

</html>
