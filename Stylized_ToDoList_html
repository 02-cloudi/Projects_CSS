<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles.css">
    <title>Styled To-Do List</title>
</head>

<body>
    <h1>My To-Do List</h1>
    <ul class="todo-list">
        <li>
            <input type="checkbox" id="checkbox-1">
            <label for="checkbox-1">Explore gaming keyboards</label>
            <ul class="sub-item">
                <li><a href="https://www.freecodecamp.org/learn/responsive-web-design-v9/lab-stylized-to-do-list/build-a-stylized-to-do-list#$0" class="sub-item-link" target="_blank">Store link</a>
                </li>
            </ul>
        </li>
            
        <li>
            <input type="checkbox" id="checkbox-2">
            <label for="checkbox-2">Finish the report</label>
            <ul class="sub-item">
                <li><a href="https://www.freecodecamp.org/learn/responsive-web-design-v9/lab-stylized-to-do-list/build-a-stylized-to-do-list#$0" class="sub-item-link" target="_blank">Request Access</a>
                </li>
            </ul>
        </li>
        
        <li>
            <input type="checkbox" id="checkbox-3">
            <label for="checkbox-3">View Phone's Warranty</label>
            <ul class="sub-item">
                <li><a href="https://www.freecodecamp.org/learn/responsive-web-design-v9/lab-stylized-to-do-list/build-a-stylized-to-do-list#$0" class="sub-item-link" target="_blank">View Receipts</a>
                </li>
            </ul>
        </li>
        
        <li>
            <input type="checkbox" id="checkbox-4">
            <label for="checkbox-4">Check Processor Specs</label>
            <ul class="sub-item">
                <li><a href="https://www.freecodecamp.org/learn/responsive-web-design-v9/lab-stylized-to-do-list/build-a-stylized-to-do-list#$0" class="sub-item-link" target="_blank">View Model Number</a>
                </li>
            </ul>
        </li>
    </ul>

</body>

</html>
